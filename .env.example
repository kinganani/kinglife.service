# KINGLIFE SHAL U — Variables d'Environnement (NE PAS COMMITTER CE FICHIER)
# =========================================================================
# Copiez ce fichier en ".env" et remplissez vos valeurs réelles.
# IMPORTANT : le fichier .env est déjà dans .gitignore
# =========================================================================

# --- Django ---
DJANGO_SECRET_KEY=votre-clé-secrète-tres-longue-et-unique
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=kinglife.dev,www.kinglife.dev,127.0.0.1

# --- Supabase / PostgreSQL ---
# Ces informations sont disponibles dans votre Dashboard Supabase :
# Settings > Database > Connection Info
SUPABASE_DB_NAME=postgres
SUPABASE_DB_USER=postgres
SUPABASE_DB_PASSWORD=VOTRE_MOT_DE_PASSE_SUPABASE_ICI
SUPABASE_DB_HOST=db.VOTRE_PROJECT_REF.supabase.co
SUPABASE_DB_PORT=5432

# --- Google Social Login ---
GOOGLE_CLIENT_ID=votre_google_client_id_ici.apps.googleusercontent.com

# --- Email (SMTP) ---
# Utilisez les identifiants de Resend, Sendinblue (Brevo) ou Gmail (avec mot de passe d'application)
EMAIL_HOST=smtp.resend.com
EMAIL_PORT=587
EMAIL_HOST_USER=resend
EMAIL_HOST_PASSWORD=re_votre_cle_secrete
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=Kinglife SHAL U <contact@kinglife.dev>
